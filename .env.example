# Sin estas claves la web funciona en MODO DEMO (con los SaaS de ejemplo de src/lib/demo.ts).
# Cuando tengas tu proyecto en Supabase, copia este archivo como .env.local (o pon las
# variables en Vercel > Settings > Environment Variables) con los datos de
# Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-clave

# Dirección pública de la web (ej: https://juanfracode.com o https://tu-proyecto.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# VidScript (/guiones). Solo en el servidor (Vercel > Environment Variables), nunca en el código.
# Clave de Anthropic (console.anthropic.com) para escribir los guiones con Claude.
ANTHROPIC_API_KEY=
# Clave de Supadata (supadata.ai) para sacar la transcripción de un link.
SUPADATA_API_KEY=
# Opcionales: GUIONES_MODEL=claude-sonnet-5-5  ·  GUIONES_FALLBACKS=off (desactiva el modelo de respaldo)
